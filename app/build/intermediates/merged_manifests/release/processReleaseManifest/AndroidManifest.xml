<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.balajifinance.contactfinder"
    android:versionCode="3"
    android:versionName="2.2" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_contact_finder"
        android:label="Contact Finder"
        android:roundIcon="@drawable/ic_contact_finder"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.balajifinance.contactfinder.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>